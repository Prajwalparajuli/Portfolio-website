# Public frontend variables only.
# Keep private database passwords and service-role secrets out of this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_UNSPLASH_ACCESS_KEY=
VITE_ADMIN_PATH=admin
VITE_ADMIN_ALLOWED_EMAILS=you@example.com
VITE_CONTACT_EMAIL=you@example.com

# Do not add VITE_ADMIN_SECRET_KEY.
# Admin access should use Supabase Auth, not a client-bundled secret link.
# VITE_ADMIN_ALLOWED_EMAILS is public by design. It is only for frontend gating.
# Keep GEMINI_API_KEY in Supabase Edge Function secrets, not in frontend env vars.

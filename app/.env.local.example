# Public frontend variables only. Paste real values here for local dev.
# Get these from your Supabase project: Settings -> API -> Project URL + anon key.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_UNSPLASH_ACCESS_KEY=
VITE_ADMIN_PATH=admin
VITE_CONTACT_EMAIL=you@example.com

# Do not add VITE_ADMIN_SECRET_KEY, VITE_ADMIN_ALLOWED_EMAILS, service-role keys,
# Gemini keys, Cron secrets, Resend keys, Adzuna keys, SerpApi keys, or database URLs.
